<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/galleryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0E17">

    <!-- 3D 渲染画布 -->
    <android.opengl.GLSurfaceView
        android:id="@+id/gallerySurfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶部悬浮控制栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="@string/gallery_activity_title"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gallerySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="@string/gallery_activity_subtitle"
                android:textColor="#A0B2C6"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 主题切换选择器 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/themeMidnight"
                style="@style/ReadTraceStatusChip"
                android:background="@drawable/bg_status_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/gallery_theme_midnight"
                android:textColor="@color/white"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/themeWarm"
                style="@style/ReadTraceStatusChip"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_dark_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/gallery_theme_warm"
                android:textColor="#E0E6ED"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/themeZen"
                style="@style/ReadTraceStatusChip"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_dark_chip"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/gallery_theme_zen"
                android:textColor="#E0E6ED"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 底部悬浮毛玻璃聚焦卡片 -->
    <LinearLayout
        android:id="@+id/focusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_glass_panel"
        android:clickable="true"
        android:elevation="12dp"
        android:focusable="true"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_book_placeholder"
            android:clipToOutline="true"
            android:outlineProvider="background">

            <ImageView
                android:id="@+id/focusCoverImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/focusMediaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_secondary_button"
                    android:fontFamily="sans"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="🎬" />

                <TextView
                    android:id="@+id/focusStatusPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_status_pill"
                    android:fontFamily="sans"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="已读" />

                <TextView
                    android:id="@+id/focusRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans"
                    android:textColor="#D4AF37"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="★ 9.2" />
            </LinearLayout>

            <TextView
                android:id="@+id/focusTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:maxLines="1"
                android:textColor="@color/readtrace_ink"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="海边的卡夫卡" />

            <TextView
                android:id="@+id/focusAuthor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:maxLines="1"
                android:textColor="@color/readtrace_muted"
                android:textSize="13sp"
                tools:text="村上春树" />

            <TextView
                android:id="@+id/focusComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:maxLines="2"
                android:textColor="@color/readtrace_ink"
                android:textSize="12sp"
                tools:text="“我们尽管是再合适不过的旅伴，但不过是各自走着各自的孤独路线而已。”" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans"
                android:text="@string/gallery_focus_view_detail"
                android:textColor="@color/readtrace_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- 空状态提示 -->
    <LinearLayout
        android:id="@+id/galleryEmptyPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏛️"
            android:textSize="56sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans"
            android:text="@string/gallery_empty_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans"
            android:gravity="center"
            android:text="@string/gallery_empty_desc"
            android:textColor="#A0B2C6"
            android:textSize="14sp" />
    </LinearLayout>

</FrameLayout>
