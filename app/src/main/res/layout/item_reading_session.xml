<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_panel_soft"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/sessionDurationBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_chip_selected"
            android:fontFamily="sans"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp"
            android:textColor="@color/readtrace_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="⏱️ 专注 45 分钟" />

        <TextView
            android:id="@+id/sessionPagesText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:textColor="@color/readtrace_ink"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="读至 P.128 ~ P.160" />

        <TextView
            android:id="@+id/sessionTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="sans"
            android:textColor="@color/readtrace_muted"
            android:textSize="11sp"
            tools:text="2026-08-23 21:30" />

        <TextView
            android:id="@+id/sessionDeleteBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/readtrace_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/sessionThoughtText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/readtrace_ink"
        android:textSize="13sp"
        tools:text="今天读到了关于狐狸被驯服的段落，心境格外宁静..." />
</LinearLayout>
