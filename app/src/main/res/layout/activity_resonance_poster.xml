<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/resonancePosterRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#12100E"
    android:orientation="vertical">

    <!-- 顶部操作栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="46dp"
            android:text="🎨 双生共鸣微卡"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSelectWorks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_dark_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="🔄 自选双星"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPosterShareTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip_selected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="📤 导出"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 中部 1:1 海报预览区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <com.example.readtrace.widget.ResonancePosterView
                android:id="@+id/resonancePosterView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- 主题切换栏与底部操作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1816"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择海报艺术主题："
            android:textColor="#C5BCAD"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <!-- 4 主题选择胶囊 -->
        <LinearLayout
            android:id="@+id/posterThemeContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/themeObsidian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_status_chip_selected"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="🌌 黑曜"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/themeRicePaper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_chip"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="📜 宣纸"
                android:textColor="#EAE2D5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/themeCyber"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_chip"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="⚡ 赛博"
                android:textColor="#EAE2D5"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/themeSunset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_dark_chip"
                android:gravity="center"
                android:paddingVertical="8dp"
                android:text="🌅 晚霞"
                android:textColor="#EAE2D5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 底部操作按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSaveResonanceAlbum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_button"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="💾 保存至相册"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnShareResonanceImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_chip_selected"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="✨ 分享微卡"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
