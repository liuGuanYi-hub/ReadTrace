<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_panel_soft"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/outlineOrderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:fontFamily="sans"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/readtrace_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="第 1 卷 · 第 2 章" />

        <TextView
            android:id="@+id/outlineTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:textColor="@color/readtrace_ink"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="荒原中的相遇与羊的肖像" />

        <TextView
            android:id="@+id/outlineDeleteBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/readtrace_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/outlineSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/readtrace_ink"
        android:textSize="13sp"
        tools:text="飞行员迫降撒哈拉沙漠，黎明时分遇到了来自B-612小行星的小王子，请求为他画一只羊。" />

    <LinearLayout
        android:id="@+id/outlineMindMapContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_status_pill"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗺️"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/outlineKeyTakeaways"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/readtrace_ink"
            android:textSize="12sp"
            tools:text="核心脉络：成人的功利偏见 vs 孩童的纯粹想象力 · 洞察本质的箱中之羊" />
    </LinearLayout>
</LinearLayout>
