<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="12dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_glass_panel_soft"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/outlineOrderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:fontFamily="sans"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="@color/readtrace_ink"
            android:textSize="10.5sp"
            android:textStyle="bold"
            tools:text="第 1 卷 · 第 2 章" />

        <TextView
            android:id="@+id/outlineTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="@color/readtrace_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="荒原中的相遇与羊的肖像" />

        <TextView
            android:id="@+id/outlineDeleteBtn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:background="@drawable/bg_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/readtrace_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/outlineSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="@color/readtrace_ink"
        android:textSize="12sp"
        tools:text="飞行员迫降撒哈拉沙漠，黎明时分遇到了来自B-612小行星的小王子，请求为他画一只羊。" />

    <LinearLayout
        android:id="@+id/outlineMindMapContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_status_pill"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🗺️"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/outlineKeyTakeaways"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:lineSpacingExtra="1dp"
            android:maxLines="2"
            android:textColor="@color/readtrace_ink"
            android:textSize="11sp"
            tools:text="核心脉络：成人的功利偏见 vs 孩童的纯粹想象力" />
    </LinearLayout>
</LinearLayout>
