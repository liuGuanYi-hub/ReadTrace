<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="10dp"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/shelfCardContainer"
        android:layout_width="168dp"
        android:layout_height="82dp"
        android:background="@drawable/bg_glass_panel"
        android:clickable="true"
        android:elevation="4dp"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <!-- 顶部徽标与指示点 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/shelfCardBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:textColor="@color/readtrace_accent"
                android:textSize="9sp"
                android:textStyle="bold"
                tools:text="🏆 影史必看" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <View
                android:id="@+id/shelfCardActiveDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_status_chip_selected"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- 主标题 -->
        <TextView
            android:id="@+id/shelfCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="@color/readtrace_ink"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="豆瓣电影 TOP 250" />

        <!-- 副标题 -->
        <TextView
            android:id="@+id/shelfCardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/readtrace_muted"
            android:textSize="10sp"
            tools:text="传世影史神作殿堂" />
    </LinearLayout>
</FrameLayout>
