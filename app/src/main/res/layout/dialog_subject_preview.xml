<?xml version="1.0" encoding="utf-8"?>
<!-- 条目预览底板：封面/标题/评分/简介 + 状态选择 + 添加至纪念 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/subjectPreviewRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel"
    android:elevation="16dp"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/discover_preview_title"
        android:textColor="@color/readtrace_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="100dp"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/previewCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/discover_cover_desc" />

            <FrameLayout
                android:id="@+id/previewCoverPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_book_placeholder"
                android:visibility="gone">

                <TextView
                    android:id="@+id/previewCoverPlaceholderEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="26sp" />
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/previewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:textColor="@color/readtrace_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/previewOriginalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/readtrace_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/previewMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/readtrace_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 模糊查重提示 -->
    <TextView
        android:id="@+id/previewDuplicateHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass_panel"
        android:padding="10dp"
        android:textColor="@color/readtrace_ink"
        android:textSize="12sp"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass_panel"
        android:overScrollMode="never"
        android:padding="10dp">

        <TextView
            android:id="@+id/previewSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:text="@string/discover_summary_loading"
            android:textColor="@color/readtrace_ink"
            android:textSize="13sp" />
    </ScrollView>

    <TextView
        android:id="@+id/previewSourceNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/readtrace_muted"
        android:textSize="10sp"
        tools:text="简介来自 Bangumi" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/discover_status_label"
        android:textColor="@color/readtrace_muted"
        android:textSize="12sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/previewStatusGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/previewStatusWishlist"
                style="@style/ReadTraceStatusChip"
                android:background="@drawable/bg_status_chip_selected"
                android:clickable="true"
                android:focusable="true"
                android:textColor="@color/white" />

            <TextView
                android:id="@+id/previewStatusReading"
                style="@style/ReadTraceStatusChip"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/previewStatusFinished"
                style="@style/ReadTraceStatusChip"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/previewStatusPaused"
                style="@style/ReadTraceStatusChip"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/previewStatusDropped"
                style="@style/ReadTraceStatusChip"
                android:layout_marginStart="10dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/previewAddButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_status_chip_selected"
        android:gravity="center"
        android:padding="14dp"
        android:text="@string/discover_add_button"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
