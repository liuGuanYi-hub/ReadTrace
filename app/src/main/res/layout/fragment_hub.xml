<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🌌 动态极光流体着色器背景 (Liquid Aurora Mesh Background) -->
    <com.example.readtrace.widget.AuroraFluidBackgroundView
        android:id="@+id/auroraBackgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 🎞️ 35mm 胶片感光颗粒微着色器 (35mm Analog Film Grain Overlay) -->
    <com.example.readtrace.widget.FilmGrainOverlayView
        android:id="@+id/hubFilmGrainOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:id="@+id/hubScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingTop="18dp"
        android:paddingEnd="16dp"
        android:paddingBottom="96dp">

        <LinearLayout
            android:id="@+id/hubContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. 🌅 顶部 Header 晨报面板 -->
            <LinearLayout
                android:id="@+id/headerPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_panel"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.example.readtrace.widget.ScrambleTextView
                        android:id="@+id/homeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="serif"
                        android:text="📖 阅痕 · 精神晨报"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/themeToggleButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="☀️"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/homeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="2dp"
                    android:text="记录看过的作品，也记录当时的自己 · 今日宜品读"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="12.5sp" />

                <!-- 快速功能操作条 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/addBtn"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1.2"
                        android:background="@drawable/bg_primary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="✦ 记录作品"
                        android:textColor="@color/white"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/importPresetBtn"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🚚 多源搬家"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/backupBtn"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="📦 备份"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/trashBtn"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. 🌟 今日在读 / 策展灵感聚焦大卡 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/heroCuratorialCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_curatorial_hero_card"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.example.readtrace.widget.EditorialBadgeView
                                android:id="@+id/heroCuratorialBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✦ 今日灵感聚焦" />

                            <TextView
                                android:id="@+id/heroBadgeMedia"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_status_pill"
                                android:paddingStart="8dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="8dp"
                                android:paddingBottom="2dp"
                                android:textColor="@color/readtrace_accent"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="92dp"
                                android:layout_height="128dp">

                                <ImageView
                                    android:id="@+id/heroBookCover"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_book_card"
                                    android:scaleType="centerCrop" />

                                <TextView
                                    android:id="@+id/heroCoverPlaceholder"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_book_placeholder"
                                    android:gravity="center"
                                    android:textColor="@color/white"
                                    android:textSize="18sp" />
                            </FrameLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:gravity="center_vertical"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/heroBookTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans"
                                    android:maxLines="2"
                                    android:textColor="@color/readtrace_ink"
                                    android:textSize="17sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/heroBookAuthor"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:textColor="@color/readtrace_muted"
                                    android:textSize="12.5sp" />

                                <TextView
                                    android:id="@+id/heroBookRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textColor="@color/readtrace_accent"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/heroBtnRead"
                                        android:layout_width="wrap_content"
                                        android:layout_height="32dp"
                                        android:background="@drawable/bg_primary_button"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:gravity="center"
                                        android:paddingStart="12dp"
                                        android:paddingEnd="12dp"
                                        android:text="📖 品读"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/heroBtnDetail"
                                        android:layout_width="wrap_content"
                                        android:layout_height="32dp"
                                        android:layout_marginStart="8dp"
                                        android:background="@drawable/bg_secondary_button"
                                        android:clickable="true"
                                        android:focusable="true"
                                        android:gravity="center"
                                        android:paddingStart="12dp"
                                        android:paddingEnd="12dp"
                                        android:text="详情 →"
                                        android:textColor="@color/readtrace_ink"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <com.example.readtrace.widget.DropCapTextView
                            android:id="@+id/heroBookQuote"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_glass_panel"
                            android:lineSpacingExtra="3dp"
                            android:padding="12dp"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12.5sp" />
                    </LinearLayout>

                    <com.example.readtrace.widget.HolographicSpecularOverlayView
                        android:id="@+id/heroSpecularOverlay"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. 💎 单行 44dp 晶体工坊微胶囊 (Crystal Workshop Capsules) -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <!-- 胶囊 0: ✨ 精神品味探索与个性推荐 (P22) -->
                    <LinearLayout
                        android:id="@+id/capsulePersonalizedDiscovery"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_dark_chip_selected"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✨"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans"
                            android:text="精神探索"
                            android:textColor="@color/white"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 胶囊 0.5: ⏳ StandBy 禅意伴读钟 (P15) -->
                    <LinearLayout
                        android:id="@+id/capsuleStandByClock"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_glass_panel"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏳"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans"
                            android:text="伴读钟"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 胶囊 1: 📻 声学磁带机 -->
                    <LinearLayout
                        android:id="@+id/capsuleVinylPlayer"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_glass_panel"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📻"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans"
                            android:text="声学磁带"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 胶囊 2: 🎴 实体藏书票与通行证 -->
                    <LinearLayout
                        android:id="@+id/capsuleExLibris"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_glass_panel"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🎴"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans"
                            android:text="文化通行证"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 胶囊 3: 📜 时光画卷 -->
                    <LinearLayout
                        android:id="@+id/capsuleMediaTimeline"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_glass_panel"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📜"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans"
                            android:text="时光画卷"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 胶囊 4: 🏛️ 3D展厅 -->
                    <LinearLayout
                        android:id="@+id/capsule3DGallery"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="10dp"
                        android:background="@drawable/bg_glass_panel"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🏛️"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans"
                            android:text="3D 展厅"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- 胶囊 5: 🌌 心智拓扑 -->
                    <LinearLayout
                        android:id="@+id/capsuleMindprintTopology"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_glass_panel"
                        android:clickable="true"
                        android:elevation="4dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🌌"
                            android:textSize="15sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:fontFamily="sans"
                            android:text="心智拓扑"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 4. 📜 羊皮纸便签横幅 -->
            <LinearLayout
                android:id="@+id/parchmentQuoteRibbon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_parchment_ribbon"
                android:clickable="true"
                android:elevation="5dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🍂 灵感微光便签"
                        android:textColor="#3D2E1E"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnRefreshParchmentQuote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔄 换一句"
                        android:textColor="#6E5A44"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.example.readtrace.widget.DropCapTextView
                    android:id="@+id/parchmentQuoteText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#2A2016"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/parchmentQuoteSource"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:textColor="#7A6852"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 4.5 🕯️ 那年今日 · 时光回溯便签 (P12) -->
            <LinearLayout
                android:id="@+id/memoryFlashbackRibbon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_parchment_ribbon"
                android:clickable="true"
                android:elevation="5dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕯️ 那年今日 · 时光回溯"
                    android:textColor="#3D2E1E"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <com.example.readtrace.widget.DropCapTextView
                    android:id="@+id/memoryFlashbackText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="#2A2016"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/memoryFlashbackHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="end"
                    android:text="轻触唤醒那段记忆 ➔"
                    android:textColor="#7A6852"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 5. ⚡ 精神能量多维统计面板 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_panel"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 精神能量全景微脉冲"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <!-- 总计 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statTotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="总藏品"
                            android:textColor="@color/readtrace_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 在读 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statReadingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/readtrace_accent"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="品读中"
                            android:textColor="@color/readtrace_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 读完 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statFinishedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="已通关"
                            android:textColor="@color/readtrace_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 愿望单 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statWishlistValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="想读/玩"
                            android:textColor="@color/readtrace_muted"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- 均分 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statAverageValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/readtrace_accent"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="平均分"
                            android:textColor="@color/readtrace_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>