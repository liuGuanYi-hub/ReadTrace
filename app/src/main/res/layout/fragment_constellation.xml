<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0C10">

    <!-- 全屏 Canvas 星系画布 -->
    <com.example.readtrace.widget.MindprintConstellationView
        android:id="@+id/constellationCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 顶部半透明浮动导航与过滤器 -->
    <LinearLayout
        android:id="@+id/constellationTopPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_glass_panel"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans"
                android:text="🌌 跨媒介心智星系"
                android:textColor="@color/readtrace_ink"
                android:textSize="19sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/btnConstellationFullscreen"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="⛶ 全屏漫游"
                android:textColor="@color/readtrace_ink"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/constellationSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans"
            android:text="双指缩放/拖拽 · 极光流光脉冲 · 双星灵魂共鸣"
            android:textColor="@color/readtrace_muted"
            android:textSize="12sp" />

        <!-- 星系过滤器 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/filterAll"
                    style="@style/ReadTraceStatusChip"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_status_chip_selected"
                    android:text="全景星系"
                    android:textColor="@color/white"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/filterBook"
                    style="@style/ReadTraceStatusChip"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:text="文学 📚"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/filterAnime"
                    style="@style/ReadTraceStatusChip"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:text="番剧 🌸"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/filterMovie"
                    style="@style/ReadTraceStatusChip"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:text="影视 🎬"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/filterGame"
                    style="@style/ReadTraceStatusChip"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:text="游戏 🎮"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/filterResonance"
                    style="@style/ReadTraceStatusChip"
                    android:layout_height="30dp"
                    android:layout_marginStart="6dp"
                    android:text="双生共鸣 ✨"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 底部悬浮选中小微卡 -->
    <LinearLayout
        android:id="@+id/constellationNodeCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="90dp"
        android:background="@drawable/bg_glass_panel"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <ImageView
            android:id="@+id/nodeCoverImage"
            android:layout_width="38dp"
            android:layout_height="56dp"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nodeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:textColor="@color/readtrace_ink"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="新世纪福音战士：终" />

            <TextView
                android:id="@+id/nodeMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/readtrace_muted"
                android:textSize="12sp"
                tools:text="🌸 番剧 · 庵野秀明 · 哲学思辨 9.8" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnNodeDetail"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="查看"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
