<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetQuoteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass"
    android:orientation="vertical"
    android:padding="13dp">

    <!-- 顶部标题栏与刷新按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:text="✨ 阅痕 · 灵感便签"
            android:textColor="@color/readtrace_accent"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetQuoteDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/readtrace_muted"
            android:textSize="10.5sp"
            tools:text="08.25" />

        <!-- 换一句桌面快捷刷新按钮 -->
        <TextView
            android:id="@+id/widgetQuoteRefreshBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_quick_action"
            android:paddingStart="6dp"
            android:paddingTop="1.5dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1.5dp"
            android:text="🔄 换一句"
            android:textColor="@color/readtrace_accent"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 书名与作者 -->
    <TextView
        android:id="@+id/widgetQuoteBookTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/readtrace_ink"
        android:textSize="13.5sp"
        android:textStyle="bold"
        tools:text="📖《百年孤独》· 马尔克斯" />

    <!-- 金句主体内容 -->
    <TextView
        android:id="@+id/widgetQuoteContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="@color/readtrace_ink"
        android:textSize="12sp"
        tools:text="“生命中真正重要的不是你遭遇了什么，而是你记住了哪些事，又是如何铭记的。”" />

    <!-- 底部状态胶囊 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetReadingTimerBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:textColor="@color/readtrace_accent"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="⏱️ 今日专注 45 min" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="查看印记 ➔"
            android:textColor="@color/readtrace_muted"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
