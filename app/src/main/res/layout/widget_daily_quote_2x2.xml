<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetQuoteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_panel"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:text="✨ 阅痕 · 每日心智"
            android:textColor="@color/readtrace_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetQuoteDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/readtrace_muted"
            android:textSize="11sp"
            tools:text="08.24" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetQuoteBookTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:textColor="@color/readtrace_ink"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="《百年孤独》" />

    <TextView
        android:id="@+id/widgetQuoteContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans"
        android:lineSpacingExtra="2dp"
        android:maxLines="3"
        android:textColor="@color/readtrace_ink"
        android:textSize="12sp"
        tools:text="“生命中真正重要的不是你遭遇了什么，而是你记住了哪些事，又是如何铭记的。”" />

    <TextView
        android:id="@+id/widgetReadingTimerBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_status_pill"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:textColor="@color/readtrace_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="⏱️ 今日专注 45 min" />

</LinearLayout>
