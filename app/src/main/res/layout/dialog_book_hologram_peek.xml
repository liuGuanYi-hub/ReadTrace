<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel_soft"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- 顶部书目概要 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/peekCoverImage"
            android:layout_width="54dp"
            android:layout_height="76dp"
            android:background="@drawable/bg_book_placeholder"
            android:elevation="4dp"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_launcher_foreground" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/peekMediaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="📖"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/peekBookTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="serif"
                    android:maxLines="1"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    tools:text="小王子" />
            </LinearLayout>

            <TextView
                android:id="@+id/peekBookAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/readtrace_muted"
                android:textSize="12.5sp"
                tools:text="圣埃克苏佩里" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/peekStatusBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_status_pill"
                    android:paddingStart="6dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="11sp"
                    tools:text="读完" />

                <TextView
                    android:id="@+id/peekRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="★ 5.0" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="#15000000" />

    <!-- 🕸️ 原生 Canvas 六维心智雷达组件 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="🕸️ 六维心智认知雷达"
        android:textColor="@color/readtrace_ink"
        android:textSize="14sp"
        android:textStyle="bold" />

    <com.example.readtrace.widget.MindprintRadarView
        android:id="@+id/peekMindprintRadar"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="4dp" />

    <!-- ⏱️ 最近一次专注阅读打卡 -->
    <LinearLayout
        android:id="@+id/peekRecentSessionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_secondary_button"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/peekSessionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="⏱️ 最近专注打卡"
            android:textColor="@color/readtrace_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/peekSessionContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/readtrace_ink"
            android:textSize="12sp"
            tools:text="专注 45 分钟 · 读至 P.45 · 初读前五章，看到箱子里的小羊，心瞬间安静了下来。" />
    </LinearLayout>

    <!-- 快捷操作按钮条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/peekActionPoster"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🎨 金句海报"
            android:textColor="@color/readtrace_ink"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/peekActionDetail"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="📖 全息档案"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
