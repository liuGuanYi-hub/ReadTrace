<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_input_glass"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/noteTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:fontFamily="sans"
            android:textColor="@color/readtrace_accent"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="摘录" />

        <TextView
            android:id="@+id/noteCreatedAt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:gravity="end"
            android:textColor="@color/readtrace_muted"
            android:textSize="12sp"
            tools:text="2026-06-07 15:20" />
    </LinearLayout>

    <TextView
        android:id="@+id/noteContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/readtrace_ink"
        android:textSize="15sp"
        tools:text="人生如旅，亦哭亦歌。" />

    <TextView
        android:id="@+id/notePositionMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:fontFamily="sans"
        android:textColor="@color/readtrace_muted"
        android:textSize="12sp"
        android:visibility="gone"
        tools:text="第 23 页 · 第一章"
        tools:visibility="visible" />
</LinearLayout>
