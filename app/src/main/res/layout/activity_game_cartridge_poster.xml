<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cartridgePosterRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10141C"
    android:orientation="vertical">

    <!-- 顶部操作栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="46dp"
            android:text="🕹️ 白金全息卡带"
            android:textColor="#FFFFFF"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSwitchGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_dark_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="7dp"
                android:text="🎮 切换游戏"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCartridgeShareTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip_selected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="📤 导出"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 中部 3:4 卡带预览区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <FrameLayout
                android:layout_width="320dp"
                android:layout_height="460dp">

                <com.example.readtrace.widget.GameCartridgePosterView
                    android:id="@+id/gameCartridgePosterView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="14dp" />

                <!-- 🌈 全息棱镜微色散光环 (Prismatic Chromatic Dispersion) -->
                <com.example.readtrace.widget.PrismaticChromaticView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="16dp" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvCartridgeSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="🕹️ 全息白金典藏卡带 · 1080P 超清通关纪念"
                android:textColor="#8B949E"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 底部主题选择器与导出面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#151D2A"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="💎 典藏全息材质"
            android:textColor="#A0C4E2"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/layoutCartridgeThemeChips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <!-- 底部快捷保存 / 分享按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnSaveCartridgeAlbum"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_button"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="💾 保存至相册"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnShareCartridgeImage"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_status_chip_selected"
                android:gravity="center"
                android:paddingVertical="12dp"
                android:text="✨ 分享卡带"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
