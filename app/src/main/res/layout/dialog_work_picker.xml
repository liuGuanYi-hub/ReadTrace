<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/workPickerSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_work_picker_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="24dp">

    <!-- 顶部居中手柄 -->
    <View
        android:layout_width="38dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle" />

    <!-- 顶栏标题与关闭按钮 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnPickerClose"
            android:orientation="vertical">

            <TextView
                android:id="@+id/pickerDialogTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="添加作品到最爱"
                android:textColor="@color/readtrace_ink"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pickerDialogSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="从已有藏品中挑选心选之作"
                android:textColor="@color/readtrace_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnPickerClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_close_glass"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/close_glass_text"
            android:textSize="13sp" />
    </RelativeLayout>

    <!-- 高定质感搜索过滤栏 -->
    <LinearLayout
        android:id="@+id/pickerSearchBlock"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_work_picker_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/pickerSearchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="搜索作品名、创作者或分类..."
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="@color/readtrace_ink"
            android:textColorHint="@color/readtrace_muted"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/btnPickerClearSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/readtrace_muted"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 作品列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="360dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/pickerRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingVertical="4dp" />

        <TextView
            android:id="@+id/pickerEmptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="暂无符合条件的已有作品"
            android:textColor="@color/readtrace_muted"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>

    <!-- 确认添加按钮 -->
    <Button
        android:id="@+id/btnConfirmAdd"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_primary_button"
        android:text="＋ 添加作品 (已选 0 部)"
        android:textColor="@android:color/white"
        android:textSize="14.5sp"
        android:textStyle="bold" />

</LinearLayout>
