<?xml version="1.0" encoding="utf-8"?>
<!--
  纪念创享工坊（v1.0.14 视觉重构）

  旧版问题：8 张结构完全相同的玻璃卡片垂直堆叠，每张都是「emoji + 标题 + 绿色实心胶囊 +
  描述 + 两个彩色标签胶囊」，视觉权重一致、没有节奏，接近后台表单列表。

  新版做法：
  1. 去掉全部 emoji，改用「序号 + 字重 + 留白」建立层级——图标库只有 4 个矢量图，
     继续用 emoji 只会让风格随系统版本漂移；
  2. 改用 bento 网格：1 张主推大卡（护照）+ 3 组双列小卡 + 1 张整行卡，
     首屏即可扫完 6 个入口，且大小对比带来节奏；
  3. 卡片去描边，靠纸张渐变与 elevation 阴影分层，边界不再用线条勾勒；
  4. 绿色只保留在序号与行动文字上，不再有大块实心按钮。

  必须保留的 id（MemoirFragment 绑定）：cardPassport / cardExLibris / cardMovieTicket /
  cardVinylPlayer / cardGameCartridge / cardResonancePoster / cardAnimeTimeline /
  cardCoverGallery / passportSubtitle / animeTimelineTitle / animeTimelineSubtitle /
  animeTimelineCountBadge / animeTimelineSpanBadge
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="20dp"
    android:paddingTop="26dp"
    android:paddingEnd="20dp"
    android:paddingBottom="28dp">

    <LinearLayout
        android:id="@+id/memoirContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ 标题区：不套面板，直接浮在极光背景上 ============ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:letterSpacing="0.2"
            android:text="MEMOIR WORKSHOP"
            android:textColor="@color/readtrace_accent"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans"
            android:text="纪念创享工坊"
            android:textColor="@color/readtrace_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans"
            android:lineSpacingExtra="4dp"
            android:text="把每一次阅读、追番、观影与通关，做成可以拿在手里的东西。"
            android:textColor="@color/readtrace_muted"
            android:textSize="13sp" />

        <!-- ============ 01 主推大卡 ============ -->
        <LinearLayout
            android:id="@+id/cardPassport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_card_paper_featured"
            android:clickable="true"
            android:elevation="7dp"
            android:focusable="true"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="20dp"
            android:paddingEnd="22dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:letterSpacing="0.18"
                    android:text="01"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:background="#263A6348" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="打开护照 →"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="sans"
                android:text="精神巡礼护照盖章簿"
                android:textColor="@color/readtrace_ink"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/passportSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:fontFamily="sans"
                android:lineSpacingExtra="3dp"
                android:text="深蓝烫金首页 · 72 部番剧入境签证 · 67 款游戏白金戳印"
                android:textColor="@color/readtrace_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- ============ 02 + 03 双列 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardExLibris"
                android:layout_width="0dp"
                android:layout_height="172dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_paper"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:letterSpacing="0.18"
                    android:text="02"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="2dp"
                    android:text="典藏藏书票工坊"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="7dp"
                    android:layout_weight="1"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:text="瑞士网格版式，生成火漆藏书票与版画藏印"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="印章工坊 →"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/cardMovieTicket"
                android:layout_width="0dp"
                android:layout_height="172dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_paper"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:letterSpacing="0.18"
                    android:text="03"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="2dp"
                    android:text="复古电影票根"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="7dp"
                    android:layout_weight="1"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:text="16:9 双联撕票打孔票根，影史评分与台词海报"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="一键生成 →"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 04 + 05 双列 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardVinylPlayer"
                android:layout_width="0dp"
                android:layout_height="172dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_paper"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:letterSpacing="0.18"
                    android:text="04"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="2dp"
                    android:text="拟真黑胶唱机"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="7dp"
                    android:layout_weight="1"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:text="Hi-Res 唱臂与律动粒子，模拟黑胶唱针微光"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="黑胶唱机 →"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/cardGameCartridge"
                android:layout_width="0dp"
                android:layout_height="172dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_paper"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:letterSpacing="0.18"
                    android:text="05"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="2dp"
                    android:text="游戏白金典藏卡带"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="7dp"
                    android:layout_weight="1"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:text="3:4 实体卡带盒，赛博光泽与白金印记"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="典藏卡带 →"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 06 + 07 双列 ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/cardResonancePoster"
                android:layout_width="0dp"
                android:layout_height="172dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_paper"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:letterSpacing="0.18"
                    android:text="06"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="2dp"
                    android:text="跨媒介双生印记"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="7dp"
                    android:layout_weight="1"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:text="同名作合璧成 1:1 微卡，六维心智同屏对照"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="11.5sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="1:1 合璧 →"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />

            <LinearLayout
                android:id="@+id/cardAnimeTimeline"
                android:layout_width="0dp"
                android:layout_height="172dp"
                android:layout_weight="1"
                android:background="@drawable/bg_card_paper"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="17dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:letterSpacing="0.18"
                    android:text="07"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- 标题由代码写入，保留 id -->
                <TextView
                    android:id="@+id/animeTimelineTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="2"
                    android:text="追番编年画卷"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/animeTimelineSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="7dp"
                    android:layout_weight="1"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="3dp"
                    android:maxLines="2"
                    android:text="和纸材质全景长图，纵览整部追番史"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="11.5sp" />

                <!-- 两个角标保留 id 供代码写入，视觉上压成一行极轻的脚注 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/animeTimelineCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:text="72 部动漫"
                        android:textColor="@color/readtrace_accent"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <!-- 年份已并入副标题，此处徽章保留 id 供代码写入但不再占位 -->
                    <TextView
                        android:id="@+id/animeTimelineSpanBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans"
                        android:text="跨越编年时光"
                        android:textColor="@color/readtrace_muted"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:text="→"
                        android:textColor="@color/readtrace_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ 08 整行卡 ============ -->
        <LinearLayout
            android:id="@+id/cardCoverGallery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_paper"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingEnd="20dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:letterSpacing="0.18"
                    android:text="08"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:fontFamily="sans"
                    android:text="全屏纯净封面画廊"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="3dp"
                    android:text="磁吸滑动封面流，动态环境光晕，221 张超清壁纸"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="14dp"
                android:fontFamily="sans"
                android:text="→"
                android:textColor="@color/readtrace_accent"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
