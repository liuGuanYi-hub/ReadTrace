<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="24dp">

    <!-- 时间轴节点轴线与微光圆点 -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 节点圆点 -->
        <View
            android:id="@+id/timelineNodeDot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_status_chip_selected" />

        <!-- 连接竖线 -->
        <View
            android:id="@+id/timelineNodeLine"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            android:layout_marginTop="4dp"
            android:background="@color/readtrace_glass_stroke" />
    </LinearLayout>

    <!-- 版本内容卡片 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_panel"
        android:elevation="4dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 顶部版本号 + 标签 + 日期 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvChangelogVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="v4.3.0"
                android:textColor="@color/readtrace_ink"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvChangelogLatestBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_status_pill"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="LATEST ✦ 最新"
                android:textColor="@color/readtrace_accent"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvChangelogDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2026-09-02"
                android:textColor="@color/readtrace_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 标签副标题 -->
        <TextView
            android:id="@+id/tvChangelogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🌌 顶级开源交互与底层加固"
            android:textColor="@color/readtrace_accent"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <!-- 详细要点列表容器 -->
        <LinearLayout
            android:id="@+id/changelogHighlightsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical" />
    </LinearLayout>
</LinearLayout>