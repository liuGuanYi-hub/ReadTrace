<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_readtrace_home"
    tools:context=".MainActivity">

    <ScrollView
        android:id="@+id/homeScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/homeContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部 Header 面板 -->
            <LinearLayout
                android:id="@+id/headerPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_panel"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/homeTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans"
                        android:letterSpacing="0"
                        android:text="@string/home_title"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/themeToggleButton"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="🌙"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="15sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/homeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/home_subtitle"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />

                <!-- 快速功能操作条 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/addButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_primary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:text="@string/home_add"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/importPresetButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/home_import_preset"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/backupButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="📦 备份"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/trashButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="@string/home_trash"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 总览统计胶囊 -->
            <LinearLayout
                android:id="@+id/insightPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans"
                        android:text="✨ 文化印记总览"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/statAverageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:textColor="@color/readtrace_accent"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        tools:text="均分 ★ 4.9" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statTotalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="202" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="总藏品"
                            android:textColor="@color/readtrace_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statReadingValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="14" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="进行中"
                            android:textColor="@color/readtrace_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/statFinishedValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            tools:text="170" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="已完成"
                            android:textColor="@color/readtrace_muted"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 展馆大板块标题 -->
            <TextView
                style="@style/ReadTraceFieldLabel"
                android:layout_marginTop="24dp"
                android:text="🏛️ 精神空间与文化展馆"
                android:textSize="17sp" />

            <!-- 1. 📚 文学书房 (Books Pavilion) -->
            <LinearLayout
                android:id="@+id/hubCardBook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_panel"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans"
                        android:text="📚 文学书房"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hubBookCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="54 本藏书"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hubBookSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:text="经典名著 · 哲学思辨 · 3D 拟真翻书阅览"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />

                <!-- 微缩封面预览流 -->
                <LinearLayout
                    android:id="@+id/hubBookCoversPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

                <!-- 底部操作条 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEnterBookHub"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_button"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:text="进入书房专区 →"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnQuickReader3D"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="📖 3D 翻书"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. 🌸 追番殿堂 (Anime Chamber) -->
            <LinearLayout
                android:id="@+id/hubCardAnime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_glass_panel"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans"
                        android:text="🌸 追番殿堂"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hubAnimeCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="70 部番剧"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hubAnimeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:text="1995-2024 追番编年史 · 精神入境签证"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />

                <!-- 微缩封面预览流 -->
                <LinearLayout
                    android:id="@+id/hubAnimeCoversPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

                <!-- 底部操作条 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEnterAnimeHub"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_button"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:text="进入追番专区 →"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnQuickAnimeTimeline"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="📜 编年画卷"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnQuickAnimePassport"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="🛂 巡礼护照"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. 🎬 光影剧场 (Cinema Theatre) -->
            <LinearLayout
                android:id="@+id/hubCardMovie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_glass_panel"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans"
                        android:text="🎬 光影剧场"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hubMovieCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="11 部光影"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hubMovieSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:text="经典影史神作 · 深度影评 · 复古透光票根"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />

                <!-- 微缩封面预览流 -->
                <LinearLayout
                    android:id="@+id/hubMovieCoversPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

                <!-- 底部操作条 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEnterMovieHub"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_button"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:text="进入剧场专区 →"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnQuickMovieTicket"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="🎟️ 透光票根"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. 🎮 第九艺术游戏宝库 (Gaming Vault) -->
            <LinearLayout
                android:id="@+id/hubCardGame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_glass_panel"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans"
                        android:text="🎮 游戏宝库"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hubGameCountBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans"
                        android:paddingStart="10dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="3dp"
                        android:text="67 款神作"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hubGameSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:text="Steam 收藏库 · 白金全息卡带 · 通关盖章簿"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />

                <!-- 微缩封面预览流 -->
                <LinearLayout
                    android:id="@+id/hubGameCoversPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal" />

                <!-- 底部操作条 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEnterGameHub"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_button"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:text="进入游戏宝库 →"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnQuickGameCartridge"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="🕹️ 全息卡带"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnQuickGamePassport"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_secondary_button"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="🛂 通关签证"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 探索与沉淀中心 -->
            <TextView
                style="@style/ReadTraceFieldLabel"
                android:layout_marginTop="28dp"
                android:text="🌌 跨媒介探索与精神沉淀"
                android:textSize="17sp" />

            <!-- 心智星系入口卡片 -->
            <LinearLayout
                android:id="@+id/homeConstellationPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_panel"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="🌌 跨媒介心智星系图谱"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:text="全量书籍、番剧、电影与游戏因精神特质相吸交织的流光星图"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 3D 展厅与画廊 -->
            <LinearLayout
                android:id="@+id/homeGalleryPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_panel"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="🏛️ 3D 私人虚拟书房展厅"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeGallerySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:text="基于 OpenGL 渲染的 360° 环形悬浮立体展台与全息封面流"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 里程碑成就大厅 -->
            <LinearLayout
                android:id="@+id/homeBadgePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_panel"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="🏅 精神阅痕成就勋章"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/homeBadgeSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp"
                    tools:text="已解锁 12/18 枚专属荣誉勋章" />
            </LinearLayout>

            <!-- 精神展览广场 -->
            <LinearLayout
                android:id="@+id/homeCommunityPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_glass_panel"
                android:clickable="true"
                android:elevation="6dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="🌐 阅痕云端展览广场"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:text="漫游探访同频策展人的 3D 虚拟展厅与灵魂长评共鸣"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 那年今日回忆卡片 -->
            <LinearLayout
                android:id="@+id/memoryPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/memoryTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="📜 那年今日时光回忆"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/memoryBookTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="《小王子》· 圣埃克苏佩里" />

                <TextView
                    android:id="@+id/memoryBookQuote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp"
                    tools:text="正因为你为你的玫瑰花费了时间，这才使你的玫瑰变得如此重要。" />
            </LinearLayout>

            <!-- 年度心智画像 -->
            <LinearLayout
                android:id="@+id/annualPersonaPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="🧠 年度认知心智画像"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/annualPersonaBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="深邃博学者" />

                <TextView
                    android:id="@+id/annualPersonaDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp"
                    tools:text="对复杂人性与宏大哲学叙事展现出极高心智共鸣" />

                <com.example.readtrace.widget.MindprintRadarView
                    android:id="@+id/annualMindprintRadar"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:layout_marginTop="10dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
