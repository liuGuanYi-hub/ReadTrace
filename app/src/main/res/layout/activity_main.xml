<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_readtrace_home">

    <!--
      Fragment 主内容容器。
      底部停在导航栏上方而不是屏幕底：这样各页面里固定在底部的元素（藏库的分页栏等）
      天然避开导航栏，不需要各自推算导航栏高度。
    -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/bottomNavBarShell"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      底部导航栏（贴底通栏）。
      原来是悬浮胶囊：左右下各留 16dp，内容一滚到底就从缝隙里透出来。
      现在宽度铺满、无外边距，底部 inset 由 MainActivity 按系统栏高度补足；
      内部 Tab 区固定 64dp，导航栏总高 = 64dp + 系统手势条高度。
    -->
    <com.example.readtrace.widget.FluidSpotlightNavBar
        android:id="@+id/bottomNavBarShell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_bottom_nav_bar_solid"
        android:elevation="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 滑动选中指示胶囊（位于 Tab 层之下，切换时弹性滑移） -->
        <View
            android:id="@+id/navIndicator"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_gravity="center_vertical"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@drawable/bg_nav_tab_active" />

        <LinearLayout
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:weightSum="5">

        <!-- Tab 1: 🏛️ 展馆 (Hub) -->
        <LinearLayout
            android:id="@+id/tabHub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

<ImageView
                android:id="@+id/tabHubIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="展馆"
                android:src="@drawable/ic_tab_hub" />

            <TextView
                android:id="@+id/tabHubLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="展馆"
                android:textColor="@color/readtrace_ink"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: 📚 藏库 (Library) -->
        <LinearLayout
            android:id="@+id/tabLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

<ImageView
                android:id="@+id/tabLibraryIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="藏库"
                android:src="@drawable/ic_tab_library" />

            <TextView
                android:id="@+id/tabLibraryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="藏库"
                android:textColor="@color/readtrace_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 3: 🌌 星系 (Galaxy) -->
        <LinearLayout
            android:id="@+id/tabGalaxy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

<ImageView
                android:id="@+id/tabGalaxyIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="星系"
                android:src="@drawable/ic_tab_galaxy" />

            <TextView
                android:id="@+id/tabGalaxyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="星系"
                android:textColor="@color/readtrace_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 4: 🎟️ 纪念 (Memoir) -->
        <LinearLayout
            android:id="@+id/tabMemoir"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

<ImageView
                android:id="@+id/tabMemoirIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="纪念"
                android:src="@drawable/ic_tab_memoir" />

            <TextView
                android:id="@+id/tabMemoirLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="纪念"
                android:textColor="@color/readtrace_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 5: 👤 我的 (Profile) -->
        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

<ImageView
                android:id="@+id/tabProfileIcon"
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:contentDescription="我的"
                android:src="@drawable/ic_tab_profile" />

            <TextView
                android:id="@+id/tabProfileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="我的"
                android:textColor="@color/readtrace_muted"
                android:textSize="10.5sp" />
        </LinearLayout>
        </LinearLayout>
    </com.example.readtrace.widget.FluidSpotlightNavBar>

    <!-- 🎞️ 模拟胶片感光颗粒与抗断层噪点层 (FilmGrainOverlayView) -->
    <com.example.readtrace.widget.FilmGrainOverlayView
        android:id="@+id/mainFilmGrainOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
