<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_readtrace_home">

    <!-- Fragment 主内容容器 -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 底部悬浮毛玻璃导航栏 (Floating M3/iOS Pill Nav Bar + 鸿蒙流光寻迹) -->
    <com.example.readtrace.widget.FluidSpotlightNavBar
        android:id="@+id/bottomNavBarShell"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_bottom_nav_bar"
        android:elevation="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- 滑动选中指示胶囊（位于 Tab 层之下，切换时弹性滑移） -->
        <View
            android:id="@+id/navIndicator"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:background="@drawable/bg_nav_tab_active" />

        <LinearLayout
            android:id="@+id/bottomNavBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:weightSum="5">

        <!-- Tab 1: 🏛️ 展馆 (Hub) -->
        <LinearLayout
            android:id="@+id/tabHub"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_tab_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabHubIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏛️"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tabHubLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="展馆"
                android:textColor="@color/readtrace_ink"
                android:textSize="10.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tab 2: 📚 藏库 (Library) -->
        <LinearLayout
            android:id="@+id/tabLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabLibraryIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📚"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tabLibraryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="藏库"
                android:textColor="@color/readtrace_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 3: 🌌 星系 (Galaxy) -->
        <LinearLayout
            android:id="@+id/tabGalaxy"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabGalaxyIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌌"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tabGalaxyLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="星系"
                android:textColor="@color/readtrace_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 4: 🎟️ 纪念 (Memoir) -->
        <LinearLayout
            android:id="@+id/tabMemoir"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabMemoirIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎟️"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tabMemoirLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="纪念"
                android:textColor="@color/readtrace_muted"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tab 5: 👤 我的 (Profile) -->
        <LinearLayout
            android:id="@+id/tabProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabProfileIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tabProfileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="我的"
                android:textColor="@color/readtrace_muted"
                android:textSize="10.5sp" />
        </LinearLayout>
        </LinearLayout>
    </com.example.readtrace.widget.FluidSpotlightNavBar>

    <!-- 🎞️ 模拟胶片感光颗粒与抗断层噪点层 (FilmGrainOverlayView) -->
    <com.example.readtrace.widget.FilmGrainOverlayView
        android:id="@+id/mainFilmGrainOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:elevation="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
