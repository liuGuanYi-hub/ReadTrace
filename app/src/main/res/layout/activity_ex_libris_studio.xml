<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/studioRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A140D"
    android:orientation="vertical">

    <!-- 顶部导航栏：左侧留给悬浮返回键，标题单行省略，右侧最多一个纯文字动作 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:letterSpacing="0.02"
                android:maxLines="1"
                android:text="藏书票工坊"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:fontFamily="sans"
                android:letterSpacing="0.14"
                android:maxLines="1"
                android:text="EX LIBRIS"
                android:textColor="#5CFFFFFF"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSwitchExLibrisBook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="切换"
            android:textColor="#C9FFE6AA"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.example.readtrace.widget.EditorialBadgeView
            android:id="@+id/studioBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- 🔮 空间标本盒包裹藏书票 (带 2.5D 深度视差) -->
            <com.example.readtrace.widget.DioramaBoxView
                android:id="@+id/dioramaStampContainer"
                android:layout_width="280dp"
                android:layout_height="420dp"
                android:layout_marginTop="12dp">

                <!-- 藏书票渲染视图 -->
                <com.example.readtrace.widget.ExLibrisStampView
                    android:id="@+id/exLibrisStampView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- 光学玻璃折射透镜层 -->
                <com.example.readtrace.widget.GlassRefractionOverlay
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </com.example.readtrace.widget.DioramaBoxView>

            <!-- 滤镜/主题切换栏 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:fontFamily="sans"
                android:letterSpacing="0.18"
                android:text="版画色系"
                android:textColor="#8CFFE6AA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnThemeParchment"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_chip_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="羊皮纸"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnThemeMidnight"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dark_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="子夜"
                    android:textColor="#4DEEEA"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btnThemeWoodcut"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dark_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="木刻"
                    android:textColor="#EAE2D5"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 金句与箴言编辑输入 -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="sans"
                android:letterSpacing="0.18"
                android:text="金句印记"
                android:textColor="#8CFFE6AA"
                android:textSize="10sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etCustomQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_dark_input"
                android:hint="输入铭刻在此藏书票上的专属金句…"
                android:padding="14dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#88FFFFFF"
                android:textSize="13.5sp" />

            <!--
              导出按钮：原来用 <Button> + android:background，
              Material Components 的 Button 默认走 colorPrimary 填充，background 被忽略，
              实际渲染成主题紫而不是设计里的墨绿。改用 TextView 承载点击，颜色才受控。
            -->
            <TextView
                android:id="@+id/btnExportExLibrisPoster"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_primary_button"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans"
                android:gravity="center"
                android:text="导出高清藏书票海报"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
