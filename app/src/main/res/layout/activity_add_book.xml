<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addBookRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_readtrace_home"
    tools:context=".AddBookActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/addBookContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/formTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:text="@string/add_book_title"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/formSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/add_book_subtitle"
                        android:textColor="@color/readtrace_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_glass_panel"
                android:elevation="10dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:text="@string/section_basic"
                    android:textSize="18sp" />

                <!-- 作品载体类型切换 -->
                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_media_type" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/mediaTypeGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/mediaTypeBook"
                            style="@style/ReadTraceStatusChip"
                            android:background="@drawable/bg_status_chip_selected"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/media_type_book"
                            android:textColor="@color/white" />

                        <TextView
                            android:id="@+id/mediaTypeAnime"
                            style="@style/ReadTraceStatusChip"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/media_type_anime" />

                        <TextView
                            android:id="@+id/mediaTypeMovie"
                            style="@style/ReadTraceStatusChip"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/media_type_movie" />

                        <TextView
                            android:id="@+id/mediaTypeGame"
                            style="@style/ReadTraceStatusChip"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/media_type_game" />

                        <TextView
                            android:id="@+id/mediaTypeMusic"
                            style="@style/ReadTraceStatusChip"
                            android:layout_marginStart="10dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:text="@string/media_type_music" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- 本地封面选择与预览 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/coverPickerContainer"
                        android:layout_width="72dp"
                        android:layout_height="108dp"
                        android:background="@drawable/bg_book_placeholder"
                        android:clickable="true"
                        android:clipToOutline="true"
                        android:focusable="true"
                        android:outlineProvider="background">

                        <ImageView
                            android:id="@+id/coverPreviewImage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/coverStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans"
                            android:text="@string/action_cover_change"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans"
                            android:text="2:3 黄金比例 · 自动中心裁剪"
                            android:textColor="@color/readtrace_muted"
                            android:textSize="12sp" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/pickCoverButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:background="@drawable/bg_secondary_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="sans"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="@string/action_pick_cover"
                                android:textColor="@color/readtrace_ink"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/removeCoverButton"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginStart="8dp"
                                android:background="@drawable/bg_secondary_button"
                                android:clickable="true"
                                android:focusable="true"
                                android:fontFamily="sans"
                                android:gravity="center"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:text="@string/action_cover_remove"
                                android:textColor="@color/readtrace_muted"
                                android:textSize="12sp"
                                android:visibility="gone"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/titleLabel"
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="20dp"
                    android:text="@string/field_title" />

                <EditText
                    android:id="@+id/titleInput"
                    style="@style/ReadTraceInput"
                    android:hint="@string/hint_title"
                    android:inputType="textCapSentences"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/authorLabel"
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_author" />

                <EditText
                    android:id="@+id/authorInput"
                    style="@style/ReadTraceInput"
                    android:hint="@string/hint_author"
                    android:inputType="textCapWords"
                    android:maxLines="2" />

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_cover_url" />

                <EditText
                    android:id="@+id/coverUrlInput"
                    style="@style/ReadTraceInput"
                    android:hint="@string/hint_cover_url"
                    android:inputType="textUri"
                    android:maxLines="2" />

                <TextView
                    android:id="@+id/categoryLabel"
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_category" />

                <EditText
                    android:id="@+id/categoryInput"
                    style="@style/ReadTraceInput"
                    android:hint="@string/hint_category"
                    android:inputType="textCapWords"
                    android:maxLines="2" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="7dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sectionRecordTitle"
                    style="@style/ReadTraceFieldLabel"
                    android:text="@string/section_reading"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/statusLabel"
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="20dp"
                    android:text="@string/field_status" />

                <Spinner
                    android:id="@+id/statusInput"
                    style="@style/ReadTraceInput"
                    android:spinnerMode="dropdown" />

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_rating" />

                <EditText
                    android:id="@+id/ratingInput"
                    style="@style/ReadTraceInput"
                    android:digits="0123456789."
                    android:hint="@string/hint_rating"
                    android:inputType="numberDecimal"
                    android:maxLines="1" />

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_tags" />

                <EditText
                    android:id="@+id/tagsInput"
                    style="@style/ReadTraceInput"
                    android:hint="@string/hint_tags"
                    android:inputType="textCapSentences"
                    android:maxLines="3" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/startDateLabel"
                            style="@style/ReadTraceFieldLabel"
                            android:text="@string/field_start_date" />

                        <TextView
                            android:id="@+id/startDateInput"
                            style="@style/ReadTraceDateInput"
                            android:text="@string/select_date"
                            android:textColor="@color/readtrace_muted" />

                        <TextView
                            android:id="@+id/clearStartDateButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="5dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans"
                            android:gravity="center"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/action_clear_date"
                            android:textColor="@color/readtrace_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/finishDateLabel"
                            style="@style/ReadTraceFieldLabel"
                            android:text="@string/field_finish_date" />

                        <TextView
                            android:id="@+id/finishDateInput"
                            style="@style/ReadTraceDateInput"
                            android:text="@string/select_date"
                            android:textColor="@color/readtrace_muted" />

                        <TextView
                            android:id="@+id/clearFinishDateButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="5dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="sans"
                            android:gravity="center"
                            android:paddingStart="4dp"
                            android:paddingEnd="4dp"
                            android:text="@string/action_clear_date"
                            android:textColor="@color/readtrace_accent"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="7dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sectionThoughtsTitle"
                    style="@style/ReadTraceFieldLabel"
                    android:text="@string/section_thoughts"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/shortCommentLabel"
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="20dp"
                    android:text="@string/field_short_comment" />

                <EditText
                    android:id="@+id/shortCommentInput"
                    style="@style/ReadTraceInput"
                    android:gravity="top"
                    android:hint="@string/hint_short_comment"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="4"
                    android:minLines="2" />

                <TextView
                    android:id="@+id/reviewLabel"
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_review" />

                <EditText
                    android:id="@+id/reviewInput"
                    style="@style/ReadTraceInput"
                    android:gravity="top"
                    android:hint="@string/hint_review"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLines="10"
                    android:minLines="5" />
            </LinearLayout>

            <!-- 💰 实体馆藏与藏本印记表单卡片 -->
            <LinearLayout
                android:id="@+id/cardCollection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="7dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sectionCollectionTitle"
                    style="@style/ReadTraceFieldLabel"
                    android:text="💰 实体馆藏与藏本印记 (选填)"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ReadTraceFieldLabel"
                            android:text="购买渠道" />

                        <EditText
                            android:id="@+id/buyChannelInput"
                            style="@style/ReadTraceInput"
                            android:hint="如：多抓鱼 / 京东"
                            android:inputType="text"
                            android:maxLines="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ReadTraceFieldLabel"
                            android:text="物理位置" />

                        <EditText
                            android:id="@+id/shelfLocationInput"
                            style="@style/ReadTraceInput"
                            android:hint="如：书架第 2 层 A 区"
                            android:inputType="text"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/bindingTypeLabel"
                            style="@style/ReadTraceFieldLabel"
                            android:text="装帧版次" />

                        <EditText
                            android:id="@+id/bindingTypeInput"
                            style="@style/ReadTraceInput"
                            android:hint="如：精装锁线 / 平装"
                            android:inputType="text"
                            android:maxLines="1" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/ReadTraceFieldLabel"
                            android:text="购入价格 (¥)" />

                        <EditText
                            android:id="@+id/buyPriceInput"
                            style="@style/ReadTraceInput"
                            android:hint="如：49.80"
                            android:inputType="numberDecimal"
                            android:maxLines="1" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/saveButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_primary_button"
                android:clickable="true"
                android:elevation="7dp"
                android:focusable="true"
                android:fontFamily="sans"
                android:gravity="center"
                android:text="@string/action_save"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
