<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mediaHubRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_readtrace_home">

    <ScrollView
        android:id="@+id/hubScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/hubContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部导航与专区 Header -->
            <LinearLayout
                android:id="@+id/hubHeaderPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_panel"
                android:elevation="6dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnHubBack"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_secondary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="←"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/hubTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:fontFamily="sans"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="🌸 追番殿堂" />

                    <TextView
                        android:id="@+id/btnHubAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_primary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="+ 记录"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/hubSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp"
                    tools:text="收录 70 部追番神作 · 57 部补完 · 13 部想追" />

                <!-- 专区专属快捷功能胶囊条 -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/hubActionContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnHubToggleViewMode"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="🍱 双列"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnHubSpecialFeature"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="📜 编年画卷"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnHubPassport"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="🛂 巡礼护照"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnHubExportScroll"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_secondary_button"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:text="📜 导出长卷"
                            android:textColor="@color/readtrace_ink"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 搜索与筛选区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 搜索框 -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_input_glass">

                    <EditText
                        android:id="@+id/hubSearchInput"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toStartOf="@+id/hubSearchClearButton"
                        android:background="@null"
                        android:drawableStart="@android:drawable/ic_menu_search"
                        android:drawablePadding="10dp"
                        android:fontFamily="sans"
                        android:hint="搜索作品、创作者、分类..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingStart="12dp"
                        android:paddingEnd="8dp"
                        android:textColor="@color/readtrace_ink"
                        android:textColorHint="@color/readtrace_muted"
                        android:textSize="14sp" />

                    <ImageView
                        android:id="@+id/hubSearchClearButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="清除搜索"
                        android:padding="8dp"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        app:tint="@color/readtrace_muted" />
                </RelativeLayout>

                <!-- 状态过滤胶囊 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/hubStatusAll"
                        style="@style/ReadTraceStatusChip"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_status_chip_selected"
                        android:text="全部"
                        android:textColor="@color/white"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/hubStatusReading"
                        style="@style/ReadTraceStatusChip"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="进行中"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/hubStatusFinished"
                        style="@style/ReadTraceStatusChip"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="已完成"
                        android:textSize="12.5sp" />

                    <TextView
                        android:id="@+id/hubStatusWishlist"
                        style="@style/ReadTraceStatusChip"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="愿望单"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <!-- 标签过滤条 -->
                <HorizontalScrollView
                    android:id="@+id/hubTagScroller"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/hubTagGroup"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/hubTagAll"
                            style="@style/ReadTraceStatusChip"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_status_chip_selected"
                            android:text="全部标签"
                            android:textColor="@color/white"
                            android:textSize="11.5sp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- 列表总计与标题 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hubSectionTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans"
                    android:text="收录藏品"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hubCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp"
                    tools:text="共 70 部" />
            </LinearLayout>

            <!-- 作品卡片列表容器 -->
            <LinearLayout
                android:id="@+id/hubBooksContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="vertical" />

            <!-- 空状态面板 -->
            <LinearLayout
                android:id="@+id/hubEmptyPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_panel"
                android:elevation="2dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp"
                android:paddingEnd="20dp"
                android:paddingBottom="28dp"
                android:visibility="gone"
                tools:visibility="visible">

                <View
                    android:layout_width="80dp"
                    android:layout_height="110dp"
                    android:background="@drawable/bg_book_placeholder" />

                <TextView
                    android:id="@+id/hubEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="sans"
                    android:text="暂无匹配作品"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/hubEmptyBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:text="换个筛选条件看看，或点击右上角添加新作品"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
