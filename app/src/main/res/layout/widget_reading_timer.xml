<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widgetTimerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_glass"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:text="⏱️ 阅痕 · 专注打卡"
            android:textColor="@color/readtrace_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetTimerDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/readtrace_muted"
            android:textSize="11sp"
            tools:text="08.25" />
    </LinearLayout>

    <!-- 中部时长与连胜大字区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widgetTimerMinutes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:textColor="@color/readtrace_ink"
                android:textSize="32sp"
                android:textStyle="bold"
                tools:text="45" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="4dp"
                android:text="min"
                android:textColor="@color/readtrace_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widgetTimerStreakBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="@color/readtrace_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="🔥 连读 5 天" />
    </LinearLayout>

    <!-- 在读目标书名提示 -->
    <TextView
        android:id="@+id/widgetTimerBookTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/readtrace_muted"
        android:textSize="11.5sp"
        tools:text="📖 正在专注《小王子》" />

    <!-- 底部双快捷交互按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetTimerStartBtn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:background="@drawable/bg_primary_button"
            android:gravity="center"
            android:text="⏱️ 专注计时"
            android:textColor="@color/white"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widgetTimerQuickPunchBtn"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_widget_quick_action"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="⚡ +15m"
            android:textColor="@color/readtrace_accent"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
