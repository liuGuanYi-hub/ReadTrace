<?xml version="1.0" encoding="utf-8"?>
<!-- ⚡ 3秒极速速记半屏弹窗：边搜边选 → 状态键秒存入库 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quickLogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_quick_log_sheet"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="26dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⚡ 极速速记"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quickLogSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="输入关键词联想公开元数据 · 点状态键 2 秒入库"
        android:textColor="#99FFFFFF"
        android:textSize="11sp" />

    <!-- 媒介类型切换胶囊行 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/quickLogMediaRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 搜索框 -->
    <EditText
        android:id="@+id/quickLogSearchInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_quick_status_idle"
        android:hint="🔍 搜索书名 / 片名 / 游戏名…"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#55FFFFFF"
        android:textSize="14sp" />

    <!-- 搜索联想结果 -->
    <ScrollView
        android:id="@+id/quickLogResultScroll"
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="10dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/quickLogResultList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- 选中作品后的确认区 -->
    <LinearLayout
        android:id="@+id/quickLogConfirmSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/quickLogPickedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/quickLogPickedCreator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#99FFFFFF"
            android:textSize="12sp" />

        <!-- 自动提炼候选标签流式胶囊 -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/quickLogTagGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:chipSpacingHorizontal="8dp"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <!-- 评分滑块 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⭐"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/quickLogRatingSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_weight="1"
                android:max="20"
                android:progress="0" />

            <TextView
                android:id="@+id/quickLogRatingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="52dp"
                android:gravity="end"
                android:text="未评分"
                android:textColor="#FFE700"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 五态大按键 -->
        <LinearLayout
            android:id="@+id/quickLogStatusRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- 关闭 / 高级录入 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/quickLogAdvancedEntry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="🛠️ 高级录入 ➔"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/quickLogClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="收起"
            android:textColor="#80FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
