<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_glass_panel_soft"
    android:elevation="3dp"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/locationTypeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_status_pill"
            android:fontFamily="sans"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/readtrace_ink"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="🪐 架空星际" />

        <TextView
            android:id="@+id/locationName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:textColor="@color/readtrace_ink"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="B-612 小行星" />

        <TextView
            android:id="@+id/locationDeleteBtn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/readtrace_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/locationDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="sans"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/readtrace_ink"
        android:textSize="13sp"
        tools:text="一座只有一间房子那么大的微型行星，上面有三座火山和一朵骄傲而脆弱的玫瑰。" />

    <TextView
        android:id="@+id/locationSignificance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_status_pill"
        android:fontFamily="sans"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/readtrace_accent"
        android:textSize="11sp"
        tools:text="📍 叙事象征：纯真灵魂的诞生地与驯服责任的终极归宿" />

    <TextView
        android:id="@+id/locationCoordinates"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans"
        android:textColor="@color/readtrace_muted"
        android:textSize="10sp"
        tools:text="🌐 空间方位：第 330 号小行星带 · 1909年发现" />
</LinearLayout>
