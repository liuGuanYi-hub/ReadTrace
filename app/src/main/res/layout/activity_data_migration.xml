<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/migrationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_readtrace_home">

    <!-- 胶片感光颗粒遮罩 -->
    <com.example.readtrace.widget.FilmGrainOverlayView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="100dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部标题栏 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="48dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:text="🚚 多源资产搬家中心"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0 门槛导入豆瓣、Bangumi、Steam 与通用表格数据。"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 平台选择胶囊行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_glass_panel"
                android:elevation="4dp"
                android:orientation="horizontal"
                android:padding="6dp">

                <TextView
                    android:id="@+id/tabMigrateDouban"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_status_chip_selected"
                    android:gravity="center"
                    android:text="📗 豆瓣"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabMigrateBangumi"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🌸 Bangumi"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tabMigrateSteam"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="🎮 Steam"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tabMigrateCsv"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="📋 CSV"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 平台引导说明卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_panel"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvMigrationGuideTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💡 豆瓣书影音导入指南"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMigrationGuideContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingMultiplier="1.2"
                    android:text="支持直接粘贴豆瓣导出的 CSV 文本，或通过下方「选取文件」导入。将自动识别标题、评分、读过日期与短评，并智能换算为六维心智模型。"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- 数据输入与文件选取区 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_panel"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="📝 粘贴数据文本 / JSON / CSV"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnPasteClipboard"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_secondary_button"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="📋 粘贴剪贴板"
                        android:textColor="@color/readtrace_accent"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <EditText
                    android:id="@+id/etMigrationRawContent"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_dark_input"
                    android:gravity="top|start"
                    android:hint="在此粘贴原始导出文本，或从下方选取本地文件..."
                    android:padding="12dp"
                    android:textColor="@color/readtrace_ink"
                    android:textColorHint="@color/readtrace_muted"
                    android:textSize="12.5sp" />

                <!-- 本地文件选择入口 -->
                <LinearLayout
                    android:id="@+id/btnPickLocalFile"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📂 从设备选取文件 (.csv / .json / .txt)"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 实时解析结果预览卡片 -->
            <LinearLayout
                android:id="@+id/migrationPreviewCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_panel"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/tvMigrationPreviewSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ 已检测到 42 部待导入作品"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMigrationPreviewDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="包含书籍 30 部 · 电影 12 部 | 已自动生成六维心智模型"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- 底部悬浮导入按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_panel"
        android:padding="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/btnExecuteMigration"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_primary_button"
            android:clickable="true"
            android:elevation="6dp"
            android:focusable="true"
            android:gravity="center"
            android:text="🚀 一键无损导入藏库"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>