<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/workPickerSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_work_picker_bottom_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp">

    <!-- 顶部居中拉手 -->
    <View
        android:layout_width="44dp"
        android:layout_height="4.5dp"
        android:layout_gravity="center_horizontal"
        android:background="#4DFFFFFF" />

    <!-- 顶栏标题与统计 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtWorkPickerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎮 选择要生成卡带的游戏"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtWorkPickerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="书库中共 67 款作品 · 点击即刻切换"
                android:textColor="#9E988F"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnWorkPickerClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_status_chip"
            android:gravity="center"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </RelativeLayout>

    <!-- 搜索过滤栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_work_picker_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etWorkPickerSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="搜索作品名、创作者或分类..."
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:singleLine="true"
            android:textColor="#FFFFFF"
            android:textColorHint="#6B6377"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/btnWorkPickerClearSearch"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="#9E988F"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 媒介分类过滤栏 (水平滚动胶囊) -->
    <HorizontalScrollView
        android:id="@+id/scrollWorkPickerMediaTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:overScrollMode="never"
        android:paddingHorizontal="16dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/containerWorkPickerMediaTabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipMediaAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_chip_selected"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="全部"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/chipMediaBook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="📚 书籍"
                android:textColor="@color/readtrace_ink"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/chipMediaAnime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="🌸 番剧"
                android:textColor="@color/readtrace_ink"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/chipMediaMovie"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="🎬 电影"
                android:textColor="@color/readtrace_ink"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/chipMediaGame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="🎮 游戏"
                android:textColor="@color/readtrace_ink"
                android:textSize="11.5sp" />

            <TextView
                android:id="@+id/chipMediaMusic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_status_chip"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="💿 音乐"
                android:textColor="@color/readtrace_ink"
                android:textSize="11.5sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 作品列表 / 空态占位 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="420dp"
        android:paddingBottom="16dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvWorkPickerList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingVertical="4dp" />

        <!-- 搜索无结果空态 -->
        <LinearLayout
            android:id="@+id/layoutWorkPickerEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌌"
                android:textSize="40sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="未检索到匹配的精神印记"
                android:textColor="#FFFFFF"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="可尝试输入其他关键词或切换媒介分类"
                android:textColor="#9E988F"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
