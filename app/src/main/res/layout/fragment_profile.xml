<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingStart="18dp"
    android:paddingTop="20dp"
    android:paddingEnd="18dp"
    android:paddingBottom="96dp">

    <LinearLayout
        android:id="@+id/profileContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 顶部 Header 面板 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_panel"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="👤 我的精神档案"
                android:textColor="@color/readtrace_ink"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileSummaryText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans"
                android:lineSpacingExtra="3dp"
                android:text="记录认知心智演化轨迹 · 沉淀灵魂深处的回忆与勋章"
                android:textColor="@color/readtrace_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 年度心智画像卡片 -->
        <LinearLayout
            android:id="@+id/annualPersonaPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_glass_panel"
            android:elevation="6dp"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="🧠 年度认知心智画像"
                android:textColor="@color/readtrace_ink"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/annualPersonaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans"
                android:textColor="@color/readtrace_accent"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="深邃博学者" />

            <TextView
                android:id="@+id/annualPersonaDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans"
                android:textColor="@color/readtrace_muted"
                android:textSize="13sp"
                tools:text="对复杂人性与宏大哲学叙事展现出极高心智共鸣" />

            <com.example.readtrace.widget.MindprintRadarView
                android:id="@+id/annualMindprintRadar"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <TextView
            style="@style/ReadTraceFieldLabel"
            android:layout_marginTop="20dp"
            android:text="🏛️ 虚拟空间与展览广场"
            android:textSize="16.5sp" />

        <!-- 3D 虚拟展厅 -->
        <LinearLayout
            android:id="@+id/profileGalleryPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_glass_panel"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="🏛️ 3D 私人虚拟书房展厅"
                android:textColor="@color/readtrace_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileGallerySummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans"
                android:text="基于 OpenGL 渲染的 360° 环形悬浮立体展台与全息封面流"
                android:textColor="@color/readtrace_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- 云端展览广场 -->
        <LinearLayout
            android:id="@+id/profileCommunityPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_panel"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="🌐 阅痕云端展览广场"
                android:textColor="@color/readtrace_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans"
                android:text="漫游探访同频策展人的 3D 虚拟展厅与灵魂长评共鸣"
                android:textColor="@color/readtrace_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- 成就勋章大厅 -->
        <LinearLayout
            android:id="@+id/profileBadgePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_panel"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="🏅 精神阅痕成就勋章"
                android:textColor="@color/readtrace_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileBadgeSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans"
                android:textColor="@color/readtrace_muted"
                android:textSize="12.5sp"
                tools:text="已解锁 12/18 枚专属荣誉勋章" />
        </LinearLayout>

        <TextView
            style="@style/ReadTraceFieldLabel"
            android:layout_marginTop="20dp"
            android:text="⚙️ 系统管理与备份恢复"
            android:textSize="16.5sp" />

        <!-- 备份与恢复 -->
        <LinearLayout
            android:id="@+id/profileBackupPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_glass_panel"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="📦 数据备份与多格式导出"
                android:textColor="@color/readtrace_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans"
                android:text="支持 JSON 完整备份、Obsidian Markdown 文集与 CSV 数据表格导出"
                android:textColor="@color/readtrace_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- 内网封面服务 -->
        <LinearLayout
            android:id="@+id/profileLanCoverPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_panel"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="🖥️ 内网封面服务"
                android:textColor="@color/readtrace_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/profileLanCoverSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans"
                android:text="连接电脑上的封面服务器，预置封面秒开且不占用安装空间"
                android:textColor="@color/readtrace_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- 回收站 -->
        <LinearLayout
            android:id="@+id/profileTrashPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_panel"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:text="🗑️ 回收站与归档恢复"
                android:textColor="@color/readtrace_ink"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans"
                android:text="查看已软删除的作品，支持一键还原或彻底清空"
                android:textColor="@color/readtrace_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
