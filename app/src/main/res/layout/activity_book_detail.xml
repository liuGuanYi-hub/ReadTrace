<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detailRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_readtrace_home"
    tools:context=".BookDetailActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/detailContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/detailBackButton"
                    android:layout_width="68dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:text="@string/action_back"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:text="@string/detail_title"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="sans"
                        android:text="@string/detail_subtitle"
                        android:textColor="@color/readtrace_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_glass_panel"
                android:elevation="10dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <View
                    android:layout_width="96dp"
                    android:layout_height="134dp"
                    android:background="@drawable/bg_book_placeholder"
                    android:contentDescription="@string/decorative_book"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/detailBookTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    tools:text="海边的卡夫卡" />

                <TextView
                    android:id="@+id/detailBookAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="15sp"
                    tools:text="村上春树" />

                <TextView
                    android:id="@+id/detailHeroMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_status_pill"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="在读 · 8.5 / 10 · 小说" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/detailEditButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:text="@string/action_edit"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailArchiveButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_danger_button"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans"
                        android:gravity="center"
                        android:text="@string/action_archive"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="7dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:text="@string/detail_section_identity"
                    android:textSize="18sp" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="18dp"
                    android:text="@string/detail_category" />

                <TextView
                    android:id="@+id/detailCategory"
                    style="@style/ReadTraceDetailValue"
                    tools:text="小说" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/detail_cover_url" />

                <TextView
                    android:id="@+id/detailCoverUrl"
                    style="@style/ReadTraceDetailValue"
                    tools:text="https://example.com/cover.jpg" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="7dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:text="@string/detail_section_reading"
                    android:textSize="18sp" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="18dp"
                    android:text="@string/detail_status" />

                <TextView
                    android:id="@+id/detailStatus"
                    style="@style/ReadTraceDetailValue"
                    tools:text="在读" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/detail_rating" />

                <TextView
                    android:id="@+id/detailRating"
                    style="@style/ReadTraceDetailValue"
                    tools:text="8.5 / 10" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/detail_tags" />

                <TextView
                    android:id="@+id/detailTags"
                    style="@style/ReadTraceDetailValue"
                    tools:text="成长 · 日本文学" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/detail_start_date" />

                <TextView
                    android:id="@+id/detailStartDate"
                    style="@style/ReadTraceDetailValue"
                    tools:text="2026-06-01" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/detail_finish_date" />

                <TextView
                    android:id="@+id/detailFinishDate"
                    style="@style/ReadTraceDetailValue"
                    tools:text="2026-06-07" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="7dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:text="@string/detail_section_thoughts"
                    android:textSize="18sp" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="18dp"
                    android:text="@string/detail_short_comment" />

                <TextView
                    android:id="@+id/detailShortComment"
                    style="@style/ReadTraceDetailValue"
                    tools:text="像潮水一样缓慢地留下来。" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/detail_review" />

                <TextView
                    android:id="@+id/detailReview"
                    style="@style/ReadTraceDetailValue"
                    tools:text="读完后仍然会想起其中的海风和沉默。" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="7dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:text="@string/detail_section_notes"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/detailNotesCount"
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    tools:text="共 3 条"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/detailNotesEmpty"
                    style="@style/ReadTraceDetailValue"
                    android:layout_marginTop="16dp"
                    android:text="@string/notes_empty_body" />

                <LinearLayout
                    android:id="@+id/detailNotesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_glass_panel_soft"
                android:elevation="7dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:text="@string/detail_section_time"
                    android:textSize="18sp" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="18dp"
                    android:text="@string/detail_created_at" />

                <TextView
                    android:id="@+id/detailCreatedAt"
                    style="@style/ReadTraceDetailValue"
                    tools:text="2026-06-07 15:20" />

                <TextView
                    style="@style/ReadTraceDetailLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/detail_updated_at" />

                <TextView
                    android:id="@+id/detailUpdatedAt"
                    style="@style/ReadTraceDetailValue"
                    tools:text="2026-06-07 16:10" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
