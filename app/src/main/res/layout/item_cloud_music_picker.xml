<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemCloudMusicContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="5dp"
    android:background="@drawable/bg_cloud_music_picker_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- 复古唱片/音符图标 -->
    <TextView
        android:id="@+id/itemCloudMusicIcon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_cloud_music_icon_circle"
        android:gravity="center"
        android:text="🎵"
        android:textColor="@color/readtrace_ink"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemCloudMusicTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="歌单名称"
            android:textColor="@color/readtrace_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemCloudMusicSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="0 首 · 网易云云村"
            android:textColor="@color/readtrace_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="›"
        android:textColor="@color/readtrace_gold_accent"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
