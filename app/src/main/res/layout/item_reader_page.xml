<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/readerPageCard"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_paper_page"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <!-- 页眉：章节名与书名 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pageBookTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="#8C7A6B"
            android:textSize="12sp"
            tools:text="小王子 · 圣埃克苏佩里" />

        <TextView
            android:id="@+id/pageChapterTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans"
            android:maxLines="1"
            android:textColor="#8C7A6B"
            android:textSize="12sp"
            tools:text="第一章" />
    </LinearLayout>

    <View
        android:id="@+id/pageHeaderDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#15000000" />

    <!-- 正文内容 -->
    <TextView
        android:id="@+id/pageContentText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:fontFamily="sans"
        android:gravity="top"
        android:lineSpacingExtra="6dp"
        android:textColor="#2D241E"
        android:textSize="17sp"
        tools:text="    六岁的时候，在一本书中我看到了一幅极精彩的插图。那是一本描写原始森林的书，书名叫《真实的故事》。画上画的是一条巨蟒正在吞食一只野兽。\n\n    我把这幅画临摹了下来，画成了我的第一号作品。" />

    <View
        android:id="@+id/pageFooterDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#15000000" />

    <!-- 页脚：页码指示 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/pageFooterBrand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans"
            android:text="READTRACE 阅痕"
            android:textColor="#B0A090"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/pageFooterNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:textColor="#8C7A6B"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="1 / 48 页 (2%)" />
    </LinearLayout>

</LinearLayout>
