<?xml version="1.0" encoding="utf-8"?>
<!-- ⏳ 桌面 StandBy 禅意翻页伴读钟：横竖屏皆可立置，常亮防烧屏 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/standbyRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05070B">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/standbyClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:text="00:00"
            android:textColor="#F2EFE6"
            android:textSize="96sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/standbyDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="—"
            android:textColor="#66FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/standbyHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="🌙 放下手机，与书共处 · 屏幕保持常亮"
            android:textColor="#44FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/standbyExit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:alpha="0.5"
        android:padding="12dp"
        android:text="✕ 轻触退出"
        android:textColor="#FFFFFF"
        android:textSize="12sp" />
</FrameLayout>
