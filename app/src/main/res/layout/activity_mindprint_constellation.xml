<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/constellationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/readtrace_background">

    <com.example.readtrace.widget.MindprintConstellationView
        android:id="@+id/constellationCanvas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 顶部浮动玻璃导航栏 -->
    <LinearLayout
        android:id="@+id/constellationHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_glass_panel"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/constellationBackBtn"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="←"
            android:textColor="@color/readtrace_ink"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="🌌 阅痕 · 心智认知星系"
                android:textColor="@color/readtrace_ink"
                android:textSize="16.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/constellationSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans"
                android:text="单指拖拽漫游 · 星线串联灵魂共鸣"
                android:textColor="@color/readtrace_muted"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 星座聚类与媒介/源流筛选栏 -->
    <HorizontalScrollView
        android:id="@+id/constellationFilterScroller"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/constellationHeader">

        <LinearLayout
            android:id="@+id/constellationFilterContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="2dp" />
    </HorizontalScrollView>

    <!-- 底部选定作品浮动微卡 -->
    <LinearLayout
        android:id="@+id/constellationDetailCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_glass_panel"
        android:elevation="14dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="68dp"
                android:background="@drawable/bg_book_placeholder"
                android:clipToOutline="true"
                android:elevation="2dp"
                android:outlineProvider="background">

                <ImageView
                    android:id="@+id/starCoverImg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/starBookTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:textColor="@color/readtrace_ink"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="《百年孤独》" />

                <TextView
                    android:id="@+id/starBookAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/readtrace_muted"
                    android:textSize="12sp"
                    tools:text="加西亚·马尔克斯 · 拉美文学" />

                <TextView
                    android:id="@+id/starMindprintSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/readtrace_accent"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="🧠 思想 9.6 · 🖋️ 文笔 9.8 · ❤️ 情感 9.2" />
            </LinearLayout>

            <TextView
                android:id="@+id/starCardCloseBtn"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_secondary_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/readtrace_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/starCrossMediaContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_secondary_button"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="7dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/starCrossMediaText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#D4AF37"
                android:textSize="11.5sp"
                android:textStyle="bold"
                tools:text="✨ 跨媒介共鸣：🌸《EVA》94% (存在主义)" />

            <TextView
                android:id="@+id/btnJumpResonanceStar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_button"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🚀 漫游聚焦"
                android:textColor="@color/readtrace_ink"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExportTwinPoster"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_button"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🎨 双生微卡"
                android:textColor="@color/readtrace_ink"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/starGoDetailBtn"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="📖 探索全息档案 ➔"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
