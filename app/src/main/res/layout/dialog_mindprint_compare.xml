<?xml version="1.0" encoding="utf-8"?>
<!--
  P40-P3：心智雷达双作品叠合对比弹窗。

  复用同一张 MindprintRadarView——控件本身已支持 compareTitle / compareMindprint，
  以金曜金（作品 A）与极光青（作品 B）双色半透明蒙层叠合呈现。
  这里只负责把它包进一个有说明文字的玻璃拟态容器。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_elegant_dialog"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <!-- 眉标 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans"
            android:letterSpacing="0.18"
            android:text="MINDPRINT · COMPARISON"
            android:textColor="@color/readtrace_muted"
            android:textSize="9.5sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans"
            android:text="🔮 心智雷达叠合对比"
            android:textColor="@color/readtrace_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/readtrace_glass_stroke" />

        <!-- 双作品标题 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/compareTitleA"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans"
                android:textColor="@color/readtrace_gold_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="A《进击的巨人 第三季 Part.2》" />

            <TextView
                android:id="@+id/compareTitleB"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans"
                android:textColor="@color/readtrace_accent"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="B《白夜行》" />
        </LinearLayout>

        <!-- 双色叠合雷达 -->
        <com.example.readtrace.widget.MindprintRadarView
            android:id="@+id/compareRadar"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="10dp" />

        <!-- 差异解读 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans"
            android:letterSpacing="0.12"
            android:text="六维取向差异"
            android:textColor="@color/readtrace_muted"
            android:textSize="10sp" />

        <LinearLayout
            android:id="@+id/compareDiffContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <!-- 关闭 -->
        <TextView
            android:id="@+id/btnCompareClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tag_outline_chip"
            android:fontFamily="sans"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="收起对比"
            android:textColor="@color/readtrace_ink"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
