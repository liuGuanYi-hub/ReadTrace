<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/addNoteRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_readtrace_home"
    tools:context=".AddNoteActivity">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/addNoteContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/formTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans"
                        android:text="@string/add_note_title"
                        android:textColor="@color/readtrace_ink"
                        android:textSize="27sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/formSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="sans"
                        android:lineSpacingExtra="2dp"
                        android:text="@string/add_note_subtitle"
                        android:textColor="@color/readtrace_muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_glass_panel"
                android:elevation="10dp"
                android:orientation="vertical">

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:text="@string/section_note_trace"
                    android:textSize="18sp" />

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="20dp"
                    android:text="@string/field_note_type" />

                <Spinner
                    android:id="@+id/noteTypeInput"
                    style="@style/ReadTraceInput"
                    android:spinnerMode="dropdown" />

                <TextView
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_note_content" />

                <EditText
                    android:id="@+id/contentInput"
                    style="@style/ReadTraceInput"
                    android:gravity="top"
                    android:hint="@string/hint_note_content"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="4"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/labelNotePage"
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_note_page" />

                <EditText
                    android:id="@+id/pageInput"
                    style="@style/ReadTraceInput"
                    android:hint="@string/hint_note_page"
                    android:inputType="text"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/labelNoteChapter"
                    style="@style/ReadTraceFieldLabel"
                    android:layout_marginTop="16dp"
                    android:text="@string/field_note_chapter" />

                <EditText
                    android:id="@+id/chapterInput"
                    style="@style/ReadTraceInput"
                    android:hint="@string/hint_note_chapter"
                    android:inputType="textCapSentences"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/saveButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="26dp"
                    android:background="@drawable/bg_primary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:text="@string/action_save_note"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/archiveButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_danger_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans"
                    android:gravity="center"
                    android:text="@string/action_archive"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
