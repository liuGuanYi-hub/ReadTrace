<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemWorkContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_work_picker_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">

    <!-- 封面区域 (圆角裁切 + 玻璃媒介徽标) -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="80dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_work_picker_cover_clip"
        android:clipToOutline="true"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/itemWorkCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <FrameLayout
            android:id="@+id/itemWorkPlaceholder"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#251F2E"
            android:visibility="gone">

            <TextView
                android:id="@+id/itemWorkPlaceholderEmoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="🎮"
                android:textSize="24sp" />
        </FrameLayout>

        <!-- 封面右下角媒介胶囊 -->
        <TextView
            android:id="@+id/itemWorkMediaBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="3dp"
            android:background="@drawable/bg_sheet_handle"
            android:alpha="0.9"
            android:paddingHorizontal="4dp"
            android:paddingVertical="1dp"
            android:text="🎮"
            android:textSize="10sp" />
    </FrameLayout>

    <!-- 中间信息区域 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemWorkTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="《Kingdom Rush》"
            android:textColor="@color/readtrace_ink"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemWorkAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="创作者: Ironhide Game Studio"
            android:textColor="@color/readtrace_muted"
            android:textSize="12sp" />

        <!-- 标签与状态栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/itemWorkCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_work_picker_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2.5dp"
                android:text="塔防策略"
                android:textColor="@color/picker_tag_text"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/itemWorkScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="★ 9.2"
                android:textColor="@color/picker_item_stroke_selected"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/itemWorkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="已通关"
                android:textColor="@color/readtrace_muted"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 右侧选中指示器 -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/itemWorkSelectedBadge"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_check_gold"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/chip_selected_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/itemWorkUnselectedRing"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_close_glass"
            android:gravity="center" />
    </FrameLayout>
</LinearLayout>
