<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cloudMusicPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cloud_music_picker_sheet_dark"
    android:orientation="vertical"
    android:paddingTop="10dp">

    <!-- 顶部拉手 -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_sheet_handle_dark" />

    <!-- 顶栏 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/btnCloudMusicPickerClose"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtCloudMusicPickerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="☁️ 我的歌单"
                android:textColor="@color/player_text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCloudMusicPickerCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="共 0 项"
                android:textColor="@color/player_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnCloudMusicPickerClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_close_glass"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/close_glass_text"
            android:textSize="13sp" />
    </RelativeLayout>

    <!-- 列表 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="180dp"
        android:paddingBottom="24dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCloudMusicPicker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:id="@+id/layoutCloudMusicPickerEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍃"
                android:textSize="44sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="这里空空如也"
                android:textColor="@color/player_text_muted"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
