<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="ReadTraceStatusChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:minWidth">52dp</item>
        <item name="android:background">@drawable/bg_status_chip</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">6dp</item>
        <item name="android:paddingEnd">6dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/readtrace_ink</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <style name="ReadTraceFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/readtrace_ink</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReadTraceInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/bg_input_glass</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingTop">13dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingBottom">13dp</item>
        <item name="android:textColor">@color/readtrace_ink</item>
        <item name="android:textColorHint">@color/readtrace_muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="ReadTraceDateInput" parent="ReadTraceInput">
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="ReadTraceDetailLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/readtrace_muted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ReadTraceDetailValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:textColor">@color/readtrace_ink</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="StarPickItem">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:textSize">30sp</item>
        <item name="android:padding">4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>
</resources>
