<?xml version="1.0" encoding="utf-8"?>
<!-- 黑胶唱机深夜弹层底：墨绿黑玻璃 + 细描边，与唱机页 player_surface 氛围一致 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="#F00D1117" />
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
        </shape>
    </item>
    <item>
        <shape>
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="28dp" />
            <stroke
                android:width="1dp"
                android:color="@color/player_card_stroke" />
        </shape>
    </item>
</layer-list>
