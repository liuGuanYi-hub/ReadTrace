<?xml version="1.0" encoding="utf-8"?>
<!-- 艺术头像卡片选中态：与未选中态 bg_avatar_chip_normal 保持同一几何规格（圆角 16dp + 1dp 描边），
     仅颜色不同，选中切换不改变卡片几何尺寸 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/readtrace_accent" />
    <stroke
        android:width="1dp"
        android:color="@color/readtrace_accent" />
    <corners android:radius="16dp" />
</shape>
