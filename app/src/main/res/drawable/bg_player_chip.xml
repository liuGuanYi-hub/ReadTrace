<?xml version="1.0" encoding="utf-8"?>
<!-- 播放页顶部功能芯片：半透明玻璃质感，与深色星空舞台协调，按压微亮 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/player_glass_pressed" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/player_glass_stroke" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/player_glass" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/player_glass_stroke" />
        </shape>
    </item>
</selector>
