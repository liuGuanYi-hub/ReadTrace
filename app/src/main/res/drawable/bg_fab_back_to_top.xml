<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/readtrace_chip" />
            <stroke
                android:width="1dp"
                android:color="@color/readtrace_accent" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/readtrace_glass" />
            <stroke
                android:width="0.8dp"
                android:color="@color/readtrace_glass_stroke" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
