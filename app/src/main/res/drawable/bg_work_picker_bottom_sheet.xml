<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层：纵向渐变深黑紫 -->
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:startColor="#231D2E"
                android:centerColor="#16121D"
                android:endColor="#0C0A11" />
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
        </shape>
    </item>
    <!-- 顶层：顶部 hairline 高光描边 -->
    <item>
        <shape>
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
            <stroke
                android:width="1dp"
                android:color="#2EFFFFFF" />
        </shape>
    </item>
</layer-list>
