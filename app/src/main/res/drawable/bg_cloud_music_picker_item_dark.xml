<?xml version="1.0" encoding="utf-8"?>
<!-- 黑胶唱机深夜弹层条目卡：玻璃描边 + 暖金按压涟漪 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/player_glass_pressed">
    <item android:id="@android:id/mask">
        <shape>
            <solid android:color="@android:color/white" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/player_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/player_card_stroke" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</ripple>
