<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/readtrace_glass" />
            <stroke
                android:width="1.5dp"
                android:color="@color/readtrace_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/readtrace_glass_soft" />
            <stroke
                android:width="1dp"
                android:color="@color/readtrace_glass_stroke" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
