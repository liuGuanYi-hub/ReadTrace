<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外层柔光圈 -->
    <item>
        <shape>
            <solid android:color="#1F2A1D14" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="#30F4A261" />
        </shape>
    </item>
    <!-- 内层实体卡 -->
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="#2A2118" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="#F4A261" />
        </shape>
    </item>
</layer-list>
