<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <solid android:color="@color/picker_item_glow_stroke" />
            <corners android:radius="18dp" />
            <stroke android:width="3dp" android:color="@color/picker_item_glow_stroke" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape>
            <solid android:color="@color/picker_item_bg_selected" />
            <corners android:radius="16dp" />
            <stroke android:width="1.5dp" android:color="@color/picker_item_stroke_selected" />
        </shape>
    </item>
</layer-list>
