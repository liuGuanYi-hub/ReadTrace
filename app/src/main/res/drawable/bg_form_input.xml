<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/form_input_bg_focused" />
            <corners android:radius="12dp" />
            <stroke android:width="1.2dp" android:color="@color/form_input_stroke_focused" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/form_input_bg" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/form_input_stroke" />
        </shape>
    </item>
</selector>
