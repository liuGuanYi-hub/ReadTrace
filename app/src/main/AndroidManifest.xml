<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".ReadTraceApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Readtrace" android:usesCleartextTraffic="true">
        <activity
            android:name=".MediaHubActivity"
            android:exported="false" />
        <activity
            android:name=".MediaTimelineScrollActivity"
            android:exported="true" />
        <activity
            android:name=".AnimeTimelineScrollActivity"
            android:exported="false" />
        <activity
            android:name=".CoverGalleryActivity"
            android:exported="false" />
        <activity
            android:name=".MovieTicketPosterActivity"
            android:exported="true" />
        <activity
            android:name=".GameCartridgePosterActivity"
            android:exported="true" />
        <activity
            android:name=".CulturalPassportActivity"
            android:exported="true" />
        <activity
            android:name=".ResonancePosterActivity"
            android:exported="true" />
        <activity
            android:name=".MindprintConstellationActivity"
            android:exported="false" />
        <activity
            android:name=".QuotePosterActivity"
            android:exported="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <activity
            android:name=".community.ui.PublishExhibitionActivity"
            android:exported="false" />
        <activity
            android:name=".community.ui.ExhibitionDetailActivity"
            android:exported="false" />
        <activity
            android:name=".community.ui.CommunityGalleryActivity"
            android:exported="false" />
        <activity
            android:name=".community.ui.CommunityActivity"
            android:exported="false" />
        <activity
            android:name=".Gallery3DActivity"
            android:exported="false" />
        <activity
            android:name=".BackupActivity"
            android:exported="false" />
        <activity
            android:name=".BadgesActivity"
            android:exported="false" />
        <activity
            android:name=".TrashActivity"
            android:exported="false" />
        <activity
            android:name=".FlipNotesActivity"
            android:exported="false" />
        <activity
            android:name=".ChangelogActivity"
            android:exported="false" />
        <activity
            android:name=".DataMigrationActivity"
            android:exported="false" />
        <activity
            android:name=".BookDetailActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="readtrace"
                    android:host="work" />
            </intent-filter>
        </activity>
        <activity
            android:name=".VinylCassettePlayerActivity"
            android:exported="true" />
        <activity
            android:name=".MindprintTopologyActivity"
            android:exported="false" />
        <activity
            android:name=".AddNoteActivity"
            android:exported="false" />
        <activity
            android:name=".AddBookActivity"
            android:exported="true" />
        <activity
            android:name=".IsbnScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".WebDavConfigActivity"
            android:exported="false" />
        <activity
            android:name=".AnnualChronicleStudioActivity"
            android:exported="false" />
        <activity
            android:name=".StandByZenDeskActivity"
            android:exported="false" />
        <activity
            android:name=".SpatialParallaxGalleryActivity"
            android:exported="false" />
        <activity
            android:name=".DiscoverActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2x2 每日金句/灵感便签轮播小组件 -->
        <receiver
            android:name=".widget.DailyQuoteWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.readtrace.widget.ACTION_REFRESH_QUOTE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_daily_quote_info" />
        </receiver>

        <!-- 4x2 在读作品进度卡片小组件 -->
        <receiver
            android:name=".widget.CurrentlyReadingWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_currently_reading_info" />
        </receiver>

        <!-- 4x2 全息心智看板小组件 -->
        <receiver
            android:name=".widget.MindprintDashboardWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_mindprint_dashboard_info" />
        </receiver>

        <!-- 🪐 跨媒介认知引力星系展厅 -->
        <activity
            android:name=".CosmicGalaxyActivity"
            android:exported="true" />

        <!-- 📜 典藏藏书票与生成式艺术工坊 -->
        <activity
            android:name=".ExLibrisStudioActivity"
            android:exported="true" />

        <!-- ✦ 策展人账号认证与先锋通行证定制 -->
        <activity
            android:name=".ui.CuratorAuthActivity"
            android:exported="true" />
        <activity
            android:name=".ui.CuratorProfileEditActivity"
            android:exported="true" />

        <!-- 📱 手机号 6 位先锋验证码速登 -->
        <activity
            android:name=".ui.PhoneAuthActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 💬 微信授权回调入口（SDK 硬性要求：必须位于 {applicationId}.wxapi 包下） -->
        <activity
            android:name=".wxapi.WXEntryActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Readtrace.Transparent" />
    </application>

    <!-- targetSdk >= 30 后，检测微信是否安装需要显式声明 queries -->
    <queries>
        <package android:name="com.tencent.mm" />
    </queries>

</manifest>
